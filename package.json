{
  "name": "venn",
  "version": "0.1.0",
  "description": "Free scheduling polls. Propose times, share a link, see when everyone overlaps. No accounts, no ads.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "staging": "node scripts/staging.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run lint:links && npm test",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "screenshots": "node scripts/screenshots.js",
    "headers": "node scripts/headers.js",
    "icons": "node scripts/icons.js",
    "og": "node scripts/og-image.js",
    "pages": "node scripts/build-pages.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=server.js --test-coverage-include='src/**' --test-coverage-include='public/**' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 test/*.test.js",
    "lint:links": "node scripts/check-links.js",
    "site": "node scripts/build-site.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sephmard/venn.git"
  },
  "bugs": {
    "url": "https://github.com/sephmard/venn/issues"
  },
  "homepage": "https://venn.day",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
